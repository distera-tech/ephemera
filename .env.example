# Copy to .env and fill in. NEVER commit .env — it is git-ignored.

# --- Mode ---------------------------------------------------------------------
# simulation: no GPU, no credentials, clearly labelled SIMULATION in the UI.
# real: provisions actual NVIDIA Brev GPUs (costs money).
EPHEMERA_MODE=simulation

# --- Database (docker-compose sets this for its own services) -----------------
DATABASE_URL=postgresql+asyncpg://ephemera:ephemera@localhost:5432/ephemera

# --- NVIDIA Brev (real mode) ---------------------------------------------------
BREV_API_KEY=
BREV_ORG=
# Optional explicit instance types (comma separated, tried in order). Leave empty to
# resolve from `brev search gpu` using the requirements below.
BREV_INSTANCE_TYPES=

# --- GPU requirements ----------------------------------------------------------
GPU_PREFERENCE=L40S
GPU_MIN_VRAM_GB=40
GPU_FALLBACK_TYPES=L40,A6000,RTX6000,A100
GPU_MIN_COMPUTE_CAPABILITY=8.0

# --- Model / inference -----------------------------------------------------------
INFERENCE_ENGINE=vllm
# Verify licence/gating on Hugging Face before real deployment (Llama models are gated).
MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
HF_TOKEN=
NGC_API_KEY=
# CUDA 12.9 build (the plain v0.30.0 tag is CUDA 13 and needs NVIDIA driver >= 580)
VLLM_IMAGE=vllm/vllm-openai:v0.30.0-cu129
VLLM_MAX_MODEL_LEN=16384

# --- Safety limits -----------------------------------------------------------------
# Calibrated on real Brev L40S runs (create ~3 min + instance setup; SSH through Brev's tunnel;
# first run downloads the vLLM image and model weights).
MAX_JOB_RUNTIME_SECONDS=3600
MAX_PROVISIONING_SECONDS=1200
BOOTSTRAP_TIMEOUT_SECONDS=600
MODEL_READY_TIMEOUT_SECONDS=1500
MAX_INPUT_CHARS=32000
GPU_MIN_FREE_DISK_GB=50
MAX_ACTIVE_JOBS=1
MAX_GPU_INSTANCES=1
MAX_QUEUED_JOBS=20
MAX_DOCUMENT_SIZE_MB=25
MAX_DOCUMENT_PAGES=100
RESULT_RETENTION_SECONDS=3600

# --- Demo ----------------------------------------------------------------------------
DEMO_FORCE_INFERENCE_FAILURE=false
DEMO_ALLOW_FAILURE_INJECTION=true
# <1 speeds up simulated durations (e.g. 0.5 for a faster demo)
SIMULATION_TIME_SCALE=1.0

LOG_LEVEL=INFO
