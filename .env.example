# Copy to .env and fill in. NEVER commit .env — it is git-ignored.
#
#   cp .env.example .env
#
# Simulation (default): nothing to fill in — `make up`, then open http://localhost:3000.
#
# Real mode (provisions actual NVIDIA Brev GPUs — costs money): edit these 3 lines below
#   EPHEMERA_MODE=real
#   BREV_API_KEY=bak-...   (Brev console → your org → API keys)
#   HF_TOKEN=hf_...        (huggingface.co → Settings → Access Tokens, read-only; accept the
#                           meta-llama/Llama-3.1-8B-Instruct licence on its model page first)
# then rebuild: docker compose -f infra/docker-compose.yml up --build -d
#
# Values are taken literally: no quotes, no spaces around "=", no trailing spaces.

# --- Mode ---------------------------------------------------------------------
# simulation: no GPU, no credentials, clearly labelled SIMULATION in the UI.
# real: provisions actual NVIDIA Brev GPUs (costs money).
EPHEMERA_MODE=simulation

# --- Secrets (real mode) ----------------------------------------------------------
BREV_API_KEY=
HF_TOKEN=
# Only for INFERENCE_ENGINE=nim (not implemented yet) — leave empty.
NGC_API_KEY=

# --- Database (docker-compose sets this for its own services) -----------------
DATABASE_URL=postgresql+asyncpg://ephemera:ephemera@localhost:5432/ephemera

# --- NVIDIA Brev -------------------------------------------------------------------
# Optional: Brev org name, only if your account belongs to several orgs.
BREV_ORG=
# Optional explicit instance types (comma separated, tried in order). Leave empty to
# resolve from `brev search gpu` using the requirements below.
BREV_INSTANCE_TYPES=
# Per-attempt SSH connect timeout through Brev's tunnel (seconds).
BREV_SSH_CONNECT_TIMEOUT_SECONDS=60
# If SSH stays unreachable this long after setup, the instance is destroyed and re-created
# on another provider (at most twice). Check your own network first with `make net-check`.
BREV_SSH_UNREACHABLE_TIMEOUT_SECONDS=300
# Optional: providers never to use (comma separated, as shown by `brev search gpu`).
BREV_EXCLUDED_PROVIDERS=
# Do NOT set BREV_HOME: it must stay the OS user's home, or ssh cannot find Brev's config.

# --- GPU requirements ----------------------------------------------------------
GPU_PREFERENCE=L40S
GPU_MIN_VRAM_GB=40
GPU_FALLBACK_TYPES=L40,A6000,RTX6000,A100
GPU_MIN_COMPUTE_CAPABILITY=8.0
# Free disk required on the instance before pulling the vLLM image + weights (GB).
GPU_MIN_FREE_DISK_GB=50

# --- Model / inference -----------------------------------------------------------
INFERENCE_ENGINE=vllm
# Verify licence/gating on Hugging Face before real deployment (Llama models are gated).
MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
# auto = chosen on the GPU from its NVIDIA driver: >= 580 → v0.30.0 (CUDA 13),
# otherwise v0.19.1 (CUDA 12.9 main build). Set an explicit image to override.
VLLM_IMAGE=auto
VLLM_MAX_MODEL_LEN=16384

# --- Time budgets (seconds) ----------------------------------------------------------
# Calibrated on real Brev L40S runs: create ~3 min + Brev instance setup + SSH, possibly
# twice if a provider's SSH is unreachable; the first run downloads the vLLM image and the
# model weights (~16 GB).
MAX_JOB_RUNTIME_SECONDS=5400
MAX_PROVISIONING_SECONDS=2100
BOOTSTRAP_TIMEOUT_SECONDS=600
MODEL_READY_TIMEOUT_SECONDS=1500

# --- Safety limits -----------------------------------------------------------------
MAX_INPUT_CHARS=32000
MAX_ACTIVE_JOBS=1
MAX_GPU_INSTANCES=1
MAX_QUEUED_JOBS=20
MAX_DOCUMENT_SIZE_MB=25
MAX_DOCUMENT_PAGES=100
RESULT_RETENTION_SECONDS=3600

# --- Demo ----------------------------------------------------------------------------
DEMO_FORCE_INFERENCE_FAILURE=false
DEMO_ALLOW_FAILURE_INJECTION=true
# <1 speeds up simulated durations (e.g. 0.5 for a faster demo)
SIMULATION_TIME_SCALE=1.0

LOG_LEVEL=INFO
